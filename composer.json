{
    "name": "internetztube/craft-slug-equals-title",
    "description": "Keeps the slug equal to the title: per section, category group or product type by default, and per element with a switch under the slug field.",
    "type": "craft-plugin",
    "version": "3.1.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "slug",
        "title",
        "slug equals title"
    ],
    "support": {
        "docs": "https://github.com/internetztube/craft-slug-equals-title/blob/3.x/README.md",
        "issues": "https://github.com/internetztube/craft-slug-equals-title/issues",
        "source": "https://github.com/internetztube/craft-slug-equals-title"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Frederic Koeberl",
            "homepage": "https://frederickoeberl.com/"
        }
    ],
    "require": {
        "craftcms/cms": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "internetztube\\slugEqualsTitle\\": "src/"
        }
    },
    "extra": {
        "name": "Slug Equals Title",
        "handle": "slug-equals-title",
        "developer": "Frederic Koeberl",
        "developerUrl": "https://frederickoeberl.com/",
        "documentationUrl": "https://github.com/internetztube/craft-slug-equals-title/blob/3.x/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/internetztube/craft-slug-equals-title/3.x/CHANGELOG.md",
        "class": "internetztube\\slugEqualsTitle\\SlugEqualsTitle"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "require-dev": {
        "craftcms/phpstan": "dev-main",
        "phpstan/phpstan": "^2.3"
    }
}
