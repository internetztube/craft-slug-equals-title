{
    "name": "internetztube/craft-slug-equals-title",
    "description": "Keeps the slug of entries equal to their title: per section or entry type by default, and per entry with a switch in the slug field.",
    "type": "craft-plugin",
    "version": "4.0.0-alpha.1",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "slug",
        "title",
        "slug equals title"
    ],
    "support": {
        "docs": "https://github.com/internetztube/craft-slug-equals-title/blob/4.x/README.md",
        "issues": "https://github.com/internetztube/craft-slug-equals-title/issues",
        "source": "https://github.com/internetztube/craft-slug-equals-title"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Frederic Koeberl",
            "homepage": "https://frederickoeberl.com/"
        }
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-alpha.20"
    },
    "autoload": {
        "psr-4": {
            "Internetztube\\SlugEqualsTitle\\": "src/",
            "Internetztube\\SlugEqualsTitle\\Database\\Migrations\\": "database/migrations/"
        }
    },
    "extra": {
        "name": "Slug Equals Title",
        "handle": "slug-equals-title",
        "developer": "Frederic Koeberl",
        "developerUrl": "https://frederickoeberl.com/",
        "documentationUrl": "https://github.com/internetztube/craft-slug-equals-title/blob/4.x/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/internetztube/craft-slug-equals-title/4.x/CHANGELOG.md",
        "class": "Internetztube\\SlugEqualsTitle\\SlugEqualsTitle"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "phpstan/phpstan": "^2.1",
        "orchestra/testbench": "^11.0"
    }
}
