{% import '_includes/forms.twig' as forms %}

<p>{{ 'For the types you tick, the slug of a new element follows its title. Every element can decide for itself with the switch in its slug field.'|t('slug-equals-title') }}</p>

{% for name, group in groups %}
    {% if group.types|length %}
        {{ forms.checkboxSelectField({
            label: group.label,
            name: name,
            options: group.types|map(type => { label: type.name, value: type.handle }),
            values: attribute(settings, name),
            showAllOption: false,
            disabled: name in overrides,
            warning: name in overrides ? 'This is being overridden by the {name} setting in config/slug-equals-title.php.'|t('slug-equals-title', { name: name }),
            errors: settings.getErrors(name),
        }) }}
    {% endif %}
{% endfor %}
