{# One article, page, category or product: its title, its address and a link to the edit page where the switch is. #}
{% set element = entry ?? category ?? product %}
{% extends '_layout.twig' %}
{% set title = element.title %}
{% block content %}
    <h1>{{ element.title }}</h1>
    <p class="uri">{{ currentSite.baseUrl|trim('/') }}/<b>{{ element.uri }}</b></p>
    <div class="prose">
        <p>The slug of this {{ element.displayName()|lower }} is <code>{{ element.slug }}</code>. {% if craft.app.plugins.getPlugin('slug-equals-title').slugs.isEnabled(element) %}It follows the title: change the title in the control panel, save, and this address changes with it.{% else %}It is its own: the title can change, the address stays.{% endif %}</p>
        <p>Nothing else to read here. The journal exists so the plugin has something to rename.</p>
    </div>
    <p class="meta"><a href="{{ element.cpEditUrl }}">Edit in the control panel</a> · <a href="{{ siteUrl }}">All entries</a></p>
{% endblock %}
